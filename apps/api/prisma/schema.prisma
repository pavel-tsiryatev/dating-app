// Схема базы данных CAMPUS. Соответствует модели IDEF1X из docs/CAMPUS_IS_model.pdf (раздел 7):
// 15 сущностей → 15 таблиц. В комментариях — хранилище DFD и задача дерева, которая пишет в таблицу.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  HIDDEN // скрыт до решения модератора (3 жалобы)
  BLOCKED
}

enum Goal {
  DATING
  FRIENDS
  ACTIVITIES
}

enum MeetingStatus {
  PROPOSED
  ACCEPTED
  DECLINED
}

enum ReportStatus {
  OPEN
  CLOSED
}

enum ReportDecision {
  REJECTED
  WARNED
  BLOCKED
}

enum TicketStatus {
  RESERVED
  PAID
  RELEASED
}

enum PaymentKind {
  TICKET
  PREMIUM
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// D1.1 Пользователи · задачи 11, 12, 33
model User {
  id              String     @id @default(uuid()) @map("user_id")
  universityEmail String     @unique @map("university_email")
  isVerified      Boolean    @default(false) @map("is_verified")
  telegramId      BigInt?    @unique @map("telegram_id") // для бота в будущем
  birthDate       DateTime   @map("birth_date") @db.Date
  role            UserRole   @default(STUDENT)
  status          UserStatus @default(ACTIVE)
  /// Когда дано согласие на обработку персональных данных (152-ФЗ, управление C2 блока A11)
  consentAt       DateTime   @default(now()) @map("consent_at")
  createdAt       DateTime   @default(now()) @map("created_at")

  profile         Profile?
  likesGiven      Like[]     @relation("LikeFrom")
  likesReceived   Like[]     @relation("LikeTo")
  matchesAsA      Match[]    @relation("MatchUserA")
  matchesAsB      Match[]    @relation("MatchUserB")
  messages        Message[]
  meetings        Meeting[]
  reportsAuthored Report[]   @relation("ReportAuthor")
  reportsAgainst  Report[]   @relation("ReportTarget")
  reportsModerated Report[]  @relation("ReportModerator")
  tickets         Ticket[]
  payments        Payment[]

  @@map("users")
}

/// D1.2 Анкеты · задача 13 (зависимая: ключ = ключ пользователя)
model Profile {
  userId            String            @id @map("user_id")
  name              String
  university        String
  institute         String
  goal              Goal
  about             String?
  hideFromInstitute Boolean           @default(false) @map("hide_from_institute")

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos            Photo[]
  interests         ProfileInterest[]

  @@map("profiles")
}

/// D1.3 Фото · задача 13 (сами файлы — в объектном хранилище S3)
model Photo {
  id         String  @id @default(uuid()) @map("photo_id")
  userId     String  @map("user_id")
  storageKey String  @map("storage_key")
  position   Int

  profile    Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, position])
  @@map("photos")
}

/// Справочник интересов
model Interest {
  id       Int               @id @default(autoincrement()) @map("interest_id")
  name     String            @unique
  profiles ProfileInterest[]

  @@map("interests")
}

/// D1.2 Анкеты: связь «многие ко многим» (зависимая)
model ProfileInterest {
  userId     String   @map("user_id")
  interestId Int      @map("interest_id")

  profile    Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("profile_interests")
}

/// D2.1 Лайки и совпадения · задача 22 (зависимая: повторный лайк невозможен)
model Like {
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  isLike     Boolean  @map("is_like")
  createdAt  DateTime @default(now()) @map("created_at")

  fromUser   User     @relation("LikeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("LikeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@id([fromUserId, toUserId])
  @@index([toUserId])
  @@map("likes")
}

/// D2.1 Лайки и совпадения · задача 22. user_a_id < user_b_id, чтобы пара была одна
model Match {
  id        String    @id @default(uuid()) @map("match_id")
  userAId   String    @map("user_a_id")
  userBId   String    @map("user_b_id")
  createdAt DateTime  @default(now()) @map("created_at")

  userA     User      @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]
  meetings  Meeting[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("matches")
}

/// D2.2 Сообщения · задача 23. client_id защищает от дублей при повторной отправке (R2)
model Message {
  id       String   @id @default(uuid()) @map("message_id")
  matchId  String   @map("match_id")
  senderId String   @map("sender_id")
  clientId String   @map("client_id")
  text     String
  sentAt   DateTime @default(now()) @map("sent_at")

  match    Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([matchId, clientId])
  @@index([matchId, sentAt])
  @@map("messages")
}

/// D2.3 Встречи · задача 24
model Meeting {
  id         String        @id @default(uuid()) @map("meeting_id")
  matchId    String        @map("match_id")
  proposerId String        @map("proposer_id")
  place      String
  meetAt     DateTime      @map("meet_at")
  status     MeetingStatus @default(PROPOSED)

  match      Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposer   User          @relation(fields: [proposerId], references: [id], onDelete: Cascade)

  @@map("meetings")
}

/// D3 Жалобы · задачи 31, 32. Одна жалоба от автора на одного человека
model Report {
  id          String          @id @default(uuid()) @map("report_id")
  authorId    String          @map("author_id")
  targetId    String          @map("target_id")
  moderatorId String?         @map("moderator_id")
  reason      String
  status      ReportStatus    @default(OPEN)
  decision    ReportDecision?
  createdAt   DateTime        @default(now()) @map("created_at")

  author      User            @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target      User            @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)
  moderator   User?           @relation("ReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@unique([authorId, targetId])
  @@index([targetId, status])
  @@map("reports")
}

/// D4.1 Партнёры · задача 41
model Partner {
  id      String  @id @default(uuid()) @map("partner_id")
  name    String
  address String
  terms   String?
  events  Event[]

  @@map("partners")
}

/// D4.2 Мероприятия · задача 42. Цена — в копейках
model Event {
  id        String   @id @default(uuid()) @map("event_id")
  partnerId String   @map("partner_id")
  title     String
  startsAt  DateTime @map("starts_at")
  capacity  Int
  price     Int

  partner   Partner  @relation(fields: [partnerId], references: [id])
  tickets   Ticket[]

  @@map("events")
}

/// D4.3 Билеты · задача 43 (зависимая: ключ = мероприятие + студент)
model Ticket {
  eventId       String       @map("event_id")
  userId        String       @map("user_id")
  paymentId     String?      @unique @map("payment_id")
  status        TicketStatus @default(RESERVED)
  reservedUntil DateTime     @map("reserved_until")

  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment       Payment?     @relation(fields: [paymentId], references: [id])

  @@id([eventId, userId])
  @@index([status, reservedUntil])
  @@map("tickets")
}

/// D5.1 Платежи · задачи 51, 52. Сумма — в копейках
model Payment {
  id                String        @id @default(uuid()) @map("payment_id")
  userId            String        @map("user_id")
  kind              PaymentKind
  amount            Int
  status            PaymentStatus @default(PENDING)
  providerPaymentId String?       @unique @map("provider_payment_id")
  idempotencyKey    String        @unique @map("idempotency_key")
  /// Ссылка на оплату: хранится, чтобы повторный запрос вернул ту же ссылку
  confirmationUrl   String?       @map("confirmation_url")
  createdAt         DateTime      @default(now()) @map("created_at")
  paidAt            DateTime?     @map("paid_at")

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket            Ticket?
  subscription      Subscription?

  @@map("payments")
}

/// D5.2 Подписки Premium · задача 52
model Subscription {
  id        String   @id @default(uuid()) @map("subscription_id")
  paymentId String   @unique @map("payment_id")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")

  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
