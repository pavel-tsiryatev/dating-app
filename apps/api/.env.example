# Скопируйте в .env и заполните
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus
REDIS_URL=redis://localhost:6379
PORT=3000

# Адреса сайта, которым разрешены запросы к API, через запятую. В production обязательно
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# Секрет для JWT: длинная случайная строка (openssl rand -hex 32)
JWT_SECRET=change-me
JWT_TTL=7d

# Домены корпоративной почты вузов, через запятую
UNIVERSITY_DOMAINS=urfu.me,urfu.ru

# Почта для кодов. Если SMTP_HOST пустой, код пишется в лог (режим разработки)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CAMPUS <no-reply@example.com>

# Оплата: fake — тестовая заглушка; yookassa — подключить позже
PAYMENT_PROVIDER=fake
PREMIUM_PRICE_KOPECKS=34900
PAYMENT_WEBHOOK_SECRET=change-me

# Локальная песочница оплаты; адрес фронтенда с /api прокси
PUBLIC_API_BASE=http://localhost:5173/api
# Локальное хранилище изображений (путь относительно apps/api)
MEDIA_DIR=.local/uploads
# HOST=127.0.0.1 для разработки; в Docker можно задать 0.0.0.0
# За reverse proxy: сколько прокси перед API (обычно 1), иначе лимиты запросов общие на всех
# TRUST_PROXY=1
