{
  "name": "campus",
  "private": true,
  "description": "CAMPUS — сервис знакомств и совместных активностей для студентов",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backend:dev": "pnpm --filter @campus/api start:dev",
    "backend:build": "pnpm --filter @campus/api build",
    "backend:test": "pnpm --filter @campus/api test",
    "backend:test:e2e": "pnpm --filter @campus/api test:e2e",
    "web:dev": "pnpm --filter campus-web dev",
    "web:test": "pnpm --filter campus-web test",
    "web:build": "pnpm --filter campus-web build"
  }
}
